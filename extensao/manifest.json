{
  "manifest_version": 3,
  "name": "Claudinho",
  "version": "1.24",
  "description": "Deixa o Claudinho tocar mÃºsica e vÃ­deo no YouTube Music e no YouTube, consultar o que tem lÃ¡ e repetir rotinas que vocÃª grava nos sites que liberar, e ajudar a responder clientes no WhatsApp Web (sem enviar nada sozinho).",
  "icons": {"128": "icone.png"},
  "permissions": ["alarms", "scripting", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:47821/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://web.whatsapp.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_popup": "popup.html", "default_icon": {"128": "icone.png"}, "default_title": "Claudinho: rotinas"},
  "background": {"service_worker": "fundo.js"},
  "content_scripts": [
    {"matches": ["https://music.youtube.com/*"], "js": ["ytmusic.js"], "run_at": "document_idle"},
    {"matches": ["https://www.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_idle"}
  ]
}
